# =============================================================================
# FinTwin AI — Environment Variables
# Copy this file to .env and fill in actual values
# NEVER commit .env to version control
# =============================================================================

# ---- Application ----
APP_NAME=FinTwin AI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-secure-random-64-char-string-in-production
ALLOWED_HOSTS=["localhost","127.0.0.1"]
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://fintwin_app:password@localhost:5432/fintwin_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2

# ---- Qdrant ----
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# ---- JWT ----
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ---- Celery ----
CELERY_BROKER_URL=redis://localhost:6379/3
CELERY_RESULT_BACKEND=redis://localhost:6379/4

# ---- AI / LLM ----
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=60

# ---- External APIs ----
GSTN_BASE_URL=https://api.gstn.gov.in/v2
GSTN_API_KEY=your-gstn-api-key
CREDIT_BUREAU_URL=https://api.cibil.com/v1
CREDIT_BUREAU_KEY=your-cibil-api-key
MARKET_DATA_URL=https://api.marketdata.app/v1
MARKET_DATA_KEY=your-market-data-key

# ---- Email (SendGrid) ----
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@fintwin.ai
SENDGRID_FROM_NAME=FinTwin AI

# ---- SMS (Twilio) ----
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

# ---- File Storage ----
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage/uploads
MAX_UPLOAD_SIZE_MB=50

# ---- Rate Limiting ----
RATE_LIMIT_PER_USER_PER_MIN=100
RATE_LIMIT_AI_PER_USER_PER_MIN=10

# ---- Encryption ----
ENCRYPTION_KEY=change-me-to-32-byte-base64-encoded-key

# ---- Monitoring ----
SENTRY_DSN=
LOG_LEVEL=INFO
